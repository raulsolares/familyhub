{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": [
    "./**/*.ts"
  ]
}
