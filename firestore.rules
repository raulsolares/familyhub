rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Único documento de la aplicación
    match /familyhub/main_state {
      // Lectura y escritura permitidas mientras no haya Firebase Auth configurado.
      // TODO: cuando se integre Firebase Auth, cambiar a:
      //   allow read, write: if request.auth != null;
      allow read, write: if true;
    }

    // Bloquear cualquier otro documento por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
